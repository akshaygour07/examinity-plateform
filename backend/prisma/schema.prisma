  displayOrder Int      @default(0) @map("display_order")
  status       String   @default("DRAFT") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([examId])
  @@map("exam_faqs")
  @@schema("exam")
}

model ExamImportJob {
  id          String          @id @default(uuid()) @db.Uuid
  importType  String          @map("import_type") @db.VarChar(50)
  fileMediaId String          @map("file_media_id") @db.Uuid
  status      String          @default("PENDING") @db.VarChar(30)
  totalRows   Int             @default(0) @map("total_rows")
  validRows   Int             @default(0) @map("valid_rows")
  invalidRows Int             @default(0) @map("invalid_rows")
  createdBy   String?         @map("created_by") @db.Uuid
  startedAt   DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  rows        ExamImportRow[]

  @@map("exam_import_jobs")
  @@schema("exam")
}

model ExamImportRow {
  id               String        @id @default(uuid()) @db.Uuid
  importJobId      String        @map("import_job_id") @db.Uuid
  rowNumber        Int           @map("row_number")
  sourceData       Json          @map("source_data")
  validationErrors Json?         @map("validation_errors")
  importStatus     String        @default("PENDING") @map("import_status") @db.VarChar(30)
  createdRecordId  String?       @map("created_record_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  job              ExamImportJob @relation(fields: [importJobId], references: [id], onDelete: Restrict)

  @@index([importJobId])
  @@map("exam_import_rows")
  @@schema("exam")
}
