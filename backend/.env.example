# Examinity API, PostgreSQL, transactional email, and object storage
POSTGRES_DB=examinity
POSTGRES_USER=examinity
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://examinity:replace-with-a-local-development-password@localhost:5432/examinity?schema=public
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
API_AUDIENCE=https://api.examinity.local
AUTH0_ADMIN_CLIENT_ID=replace-with-the-dedicated-admin-application-client-id
AUTH0_CLAIM_NAMESPACE=https://examinity.in/
JWT_CLOCK_TOLERANCE_SECONDS=60
TERMS_VERSION=v1
# LEGACY / OUT OF SCOPE unless the client approves WhatsApp-first/SMS-fallback delivery.
# Do not configure this provider block for the Auth0-only Module 1 phone OTP flow.
# Auth0 Custom Phone Provider -> Nest callback. Use a random secret of at least 32 characters.
PHONE_PROVIDER_API_SECRET=replace-with-random-32-byte-secret
# Twilio Programmable Messaging senders. WhatsApp sender must be registered and template approved.
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=replace-with-secret-manager-value
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
TWILIO_SMS_FROM=+10000000000
TWILIO_WHATSAPP_CONTENT_SID=HX00000000000000000000000000000000
# Replace with the exact SMS text registered with the provider; {{1}} is the OTP variable.
TWILIO_SMS_TEMPLATE_BODY=replace-with-approved-OTP-template-containing-{{1}}
# Required for +91 recipients using India's DLT route. Use the client's registered PE and template IDs.
TWILIO_DLT_PE_ID=replace-with-registered-PE-ID
TWILIO_DLT_TEMPLATE_ID=replace-with-approved-DLT-template-ID
# Public HTTPS route used by Twilio status callbacks (not the Auth0 Action endpoint).
TWILIO_STATUS_CALLBACK_URL=https://api.example.com/api/v1/auth/phone/twilio-status
# Base64 encoding of 32 random bytes. OTP payload is AES-GCM encrypted only until delivery/fallback or expiry.
PHONE_OTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PHONE_OTP_FALLBACK_TTL_SECONDS=300
EMAIL_PROVIDER=resend
EMAIL_FROM=Examinity <notifications@example.invalid>
EMAIL_REPLY_TO=support@example.invalid
EMAIL_API_KEY=replace-with-secret-manager-value
STORAGE_ENDPOINT=https://account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=examinity-private
STORAGE_ACCESS_KEY_ID=replace-with-secret-manager-value
STORAGE_SECRET_ACCESS_KEY=replace-with-secret-manager-value

NODE_ENV=development
