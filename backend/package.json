{
  "name": "@examinity/backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "lint": "eslint src scripts prisma test",
    "format:write": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.spec.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "smoke:identity": "tsx scripts/verify-compiled-identity-flow.ts",
    "dev:mock-auth": "tsx scripts/dev-token-issuer.ts",
    "bootstrap:super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "client:demo": "node scripts/run-client-demo.mjs",
    "client:demo:check": "node scripts/check-client-demo.mjs",
    "postman:admin:build": "node scripts/update-admin-postman.mjs && node scripts/build-admin-qa-postman.mjs && node scripts/normalize-session-postman.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.1.3",
    "pg": "8.23.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "^30.5.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "ts-jest": "~29.4.15",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
